# StudioLynk .gitignore

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Java & Spring Boot (Backend)
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.nar
*.ear
*.log

# Node & Frontend
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python & ML Service
ml-service/venv/
ml-service/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
ml-service/.pytest_cache/
ml-service/data/synthetic_freelancers_dataset.csv
ml-service/model/*.joblib
ml-service/model/*.pkl

# OS & IDE
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/
*.swp
*~
