# StudioLynk Environment Variables Template
# Copy this file to .env and configure real credentials. NEVER commit .env to source control!

# ==============================================================================
# Database Configuration (MySQL co-located on EC2)
# ==============================================================================
DB_URL=jdbc:mysql://127.0.0.1:3306/studiolynk?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=studiolynk_user
DB_PASSWORD=your_secure_mysql_password_here

# ==============================================================================
# Spring Boot Backend Configuration
# ==============================================================================
SERVER_PORT=8080
JWT_SECRET=your_base64_or_hex_encoded_secret_key_at_least_256_bits_length
JWT_EXPIRATION_HOURS=24

# ==============================================================================
# SMTP Email Configuration (Gmail SMTP with App Password)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_EMAIL=your_smtp_from_email@gmail.com

# ==============================================================================
# AWS S3 Configuration (Object Storage for Profiles & Portfolios)
# ==============================================================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
S3_BUCKET_NAME=your_s3_bucket_name_here

# ==============================================================================
# ML Prediction Microservice
# ==============================================================================
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://127.0.0.1:8000

# ==============================================================================
# Frontend Configuration (Vite)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws
